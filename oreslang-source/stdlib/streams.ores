// Native Oreslang stream wrappers. The host bridge only supplies Channel<T>.
// These types are installed into the standard prelude and need no import.

// ReadableStream is a cold, single-consumer, pull stream. Its iteration
// delegates to native Observable.from_ch; it doesn't create a reader thread.
pub define class ReadableStream<T> as
  val Channel<T> source;

  pub [Symbol.iterator](): Iterator<T> {
    return Observable.from_ch(self.source);
  }
end

// A tee of WRITE-ONLY sinks is a composed writable, not a readable stream.
// Every write awaits both bounded admissions in order. A sink failure after
// the first admission can cause a partial fan-out; no atomicity is claimed.
pub define class WritableTee as
  val Channel<String> primary;
  val Channel<String> secondary;

  // A class instance self-borrow must not cross suspension.
  // Register both bounded admissions without suspending inside the method;
  // the consumer can await the combined Future outside the self-borrow.
  pub write(String frame): Future<List<void>> {
    val first = nb writech self.primary, frame;
    val second = nb writech self.secondary, frame;
    return Future.all([first, second]);
  }
end
